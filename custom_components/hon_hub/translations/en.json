        "device_id": {
          "name": "Appliance",
          "description": "The appliance to start."
        },
        "program": {
          "name": "Program",
          "description": "Name as shown in \"Program to start\" (for example Eco 40-60), its code (eco_40_60) or its key (PROGRAMS.X.Y)."
        },
        "options": {
          "name": "Options",
          "description": "Options of the program with their hOn name, for example temp, spinSpeed, delayTime (minutes), dryOption, dryLevel."
        },
        "validate_only": {
          "name": "Check only",
          "description": "Build and check the command without sending it: the answer shows what would be sent."
        }
      }
    }
