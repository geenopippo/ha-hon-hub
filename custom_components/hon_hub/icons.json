      "phase": {"default": "mdi:progress-clock"},
      "remaining_time": {"default": "mdi:timer-sand"},
      "end_time": {"default": "mdi:clock-end"},
      "total_cycles": {"default": "mdi:counter"},
      "spin_speed": {"default": "mdi:rotate-right"},
      "dry_level": {"default": "mdi:tumble-dryer"},
      "error_code": {"default": "mdi:alert-circle-outline"},
      "tabs": {"default": "mdi:pill"},
      "filter_cleaning": {"default": "mdi:air-filter"},
      "drum_cleaning": {"default": "mdi:washing-machine-alert"},
      "drawer_cleaning": {"default": "mdi:tray"},
      "spray_arms_cleaning": {"default": "mdi:sprinkler-variant"},
      "zone_power": {"default": "mdi:circle-slice-8"}
