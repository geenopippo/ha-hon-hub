      "resume": {"default": "mdi:play-pause"},
      "stop": {"default": "mdi:stop"},
      "reset_filter_cleaning": {"default": "mdi:restore"},
      "reset_drum_cleaning": {"default": "mdi:restore"},
      "reset_drawer_cleaning": {"default": "mdi:restore"},
      "reset_spray_arms_cleaning": {"default": "mdi:restore"}
